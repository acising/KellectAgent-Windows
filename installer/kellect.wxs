<?xml version="1.0" encoding="UTF-8"?>
<!--
  kellect MSI - WiX v4/v5/v7 source (with install UI + customizable options).
  Per-machine installer that:
    * lays kellect.exe + 4 DLLs + config into [ProgramFilesFolder]kellect\
      (Program Files (x86); collector is x86), and the GUI + Qt/CRT runtime
      into the gui\ subfolder
    * Start Menu shortcut for the GUI (always, when the GUI feature is installed)
    * install UI: one hand-authored SetupOptionsDlg (WixUI_Common; WIX0094 blocks stock sets; no license)
    * major upgrades via a fixed UpgradeCode

  (The Windows-service wrapper was removed on 2026-09-19; see
  dist/kellect-service-backup-20260919.zip for the pre-removal state.)

  Build:  wix build kellect.wxs -ext WixToolset.UI.wixext -o build-msi\Kellect-win-x64.msi
  (build-msi.bat assembles stage\ first.)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include Variables.wxi ?>

  <Package Name="$(var.ProductDisplay)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)"
           Language="1033"
           UpgradeCode="$(var.UpgradeCode)">

    <!-- AllowSameVersionUpgrades: ProductCode regenerates every build while
         Version stays fixed; without this flag a same-version rebuild installs
         SIDE BY SIDE with the previous test install instead of replacing it. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kellect" />

    <!-- Install UI: stock dialog SETS are internal in WiX v7 (WIX0094), so UIRef WixUI_Common
         + one hand-authored SetupOptionsDlg (folder + GUI + shortcut), shown After CostFinalize. -->
    <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
    <!-- GUI installed by default (radio "1"). "Skip the GUI" -> INSTALLGUI="0" -> Remove Gui
         on the Install button. Never null: the choice is a RadioButtonGroup (see below). -->
    <Property Id="INSTALLGUI" Value="1" />

    <UI>
      <UIRef Id="WixUI_Common" />

      <!-- WixUI_Common emits no TextStyle table; define the standard WixUI_Font_* locally (else Error 2228). -->
      <TextStyle Id="WixUI_Font_Normal"     FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger"     FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title"      FaceName="Tahoma" Size="9" Bold="yes" />
      <TextStyle Id="WixUI_Font_Emphasized" FaceName="Tahoma" Size="8" Bold="yes" />
      <TextStyle Id="WixUI_Font_UIText"     FaceName="Tahoma" Size="8" />

      <!-- Single setup-options page (folder + GUI + shortcut), shown After CostFinalize. The
           Install button does SetTargetPath -> AddLocal/Remove Gui -> EndDialog Return. Only
           CancelDlg is pulled in (SpawnDialog); fonts defined locally above. -->
      <Dialog Id="SetupOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Setup options" />
        <Control Id="Description" Type="Text" X="25" Y="22" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the install folder and options, then click Install." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <!-- Typed PathEdit on INSTALLDIR. SetTargetPath on Install is REQUIRED, else execute-
             CostFinalize re-resolves INSTALLDIR from the Directory table and reverts the typed
             path to the default. No Browse button: BrowseDlg's SetTargetPath reverts invalid picks. -->
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="330" Height="10" NoPrefix="yes" Text="Install folder (type a full path, e.g. D:\kellect):" />
        <Control Id="FolderEdit" Type="PathEdit" X="20" Y="73" Width="330" Height="18" Property="INSTALLDIR" />

        <!-- GUI choice is a RadioButtonGroup, NOT a CheckBox: a checkbox NULLs its property on
             uncheck, and older MSI engines (notably Win7 SP1) do not reliably restore it on
             re-check: the box looks re-checked but AddLocal never fires and Remove does.
             Radio values are always well-defined ("1"/"0"), so the Install-button publishes
             below are deterministic on every engine. -->
        <Control Id="InstallGui" Type="RadioButtonGroup" X="20" Y="98" Width="330" Height="40" Property="INSTALLGUI">
          <RadioButtonGroup Property="INSTALLGUI">
            <RadioButton Value="1" X="0" Y="0" Width="330" Height="17" Text="Install the kellect visualization GUI" />
            <RadioButton Value="0" X="0" Y="20" Width="330" Height="17" Text="Do not install the GUI" />
          </RadioButtonGroup>
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Install">
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="1" Condition="1" />
          <Publish Event="AddLocal" Value="Gui" Order="2" Condition='INSTALLGUI = "1"' />
          <Publish Event="Remove" Value="Gui" Order="3" Condition='INSTALLGUI &lt;&gt; "1"' />
          <Publish Event="EndDialog" Value="Return" Order="4" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
    </UI>

    <InstallUISequence>
      <!-- Single options dialog, After CostFinalize so INSTALLDIR is resolved before AddLocal. -->
      <Show Dialog="SetupOptionsDlg" After="CostFinalize" />
      <!-- No Welcome/Exit page: stock SETS internal (WIX0094) + Common owns those symbols
           (WIX7009). Single-page wizard: SetupOptions -> Install -> done. -->
    </InstallUISequence>

    <Feature Id="Complete" Title="$(var.ProductName)" Level="1"
             Display="expand" Description="kellect collector and GUI.">
      <Feature Id="Core" Title="Collector" Level="1"
               Description="kellect.exe and runtime DLLs.">
        <ComponentGroupRef Id="cg.MainFiles" />
      </Feature>
      <Feature Id="Gui" Title="Visualization GUI" Level="1"
               Description="KellectConsole.exe (Qt).">
        <!-- GUI install state is toggled by the wizard's INSTALLGUI checkbox via
             AddLocal/Remove on the Install button (WiX v7 dropped Feature <Condition>). -->
        <ComponentRef Id="cmp.GuiExe" />
        <ComponentRef Id="cmp.StartMenuShortcut" />
        <ComponentGroupRef Id="cg.QtRuntime" />
      </Feature>
    </Feature>
  </Package>

  <!-- ===================== Directory tree ===================== -->
  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLDIR" Name="kellect">
        <Directory Id="ConfigDir" Name="config" />
        <!-- GUI 及其全部运行时(Qt DLL/CRT/UCRT)整体收进 gui\,安装根目录保持整洁 -->
        <Directory Id="GuiDir" Name="gui">
          <Directory Id="QtPlatformsDir" Name="platforms" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="kellect" />
    </StandardDirectory>
  </Fragment>

  <!-- ===================== Main files + config ===================== -->
  <Fragment>
    <ComponentGroup Id="cg.MainFiles" Directory="INSTALLDIR">
      <Component Id="cmp.CollectorExe" Guid="*">
        <File Id="file.CollectorExe" Source="$(var.StageDir)kellect.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp.CollectorManifest" Guid="*">
        <File Id="file.CollectorManifest" Source="$(var.StageDir)kellect.exe.manifest" KeyPath="yes" />
      </Component>

      <Component Id="cmp.DllLibrdkafka" Guid="*"><File Id="file.Librdkafka" Source="$(var.StageDir)librdkafka.dll" KeyPath="yes" /></Component>
      <Component Id="cmp.DllLibrdkafkacpp" Guid="*"><File Id="file.Librdkafkacpp" Source="$(var.StageDir)librdkafkacpp.dll" KeyPath="yes" /></Component>
      <Component Id="cmp.DllLibzstd" Guid="*"><File Id="file.Libzstd" Source="$(var.StageDir)libzstd.dll" KeyPath="yes" /></Component>
      <Component Id="cmp.DllZlib" Guid="*"><File Id="file.Zlib" Source="$(var.StageDir)zlib.dll" KeyPath="yes" /></Component>

      <!-- config\: runtime-read set (win7/win10 xml, initImages, filter, log.conf) -->
      <Component Id="cmp.CfgWin7"         Guid="*" Directory="ConfigDir"><File Id="file.CfgWin7"         Source="$(var.StageDir)config\eventStruct_win7.xml"  KeyPath="yes" /></Component>
      <Component Id="cmp.CfgWin10"        Guid="*" Directory="ConfigDir"><File Id="file.CfgWin10"        Source="$(var.StageDir)config\eventStruct_win10.xml" KeyPath="yes" /></Component>
      <Component Id="cmp.CfgInitImages"   Guid="*" Directory="ConfigDir"><File Id="file.CfgInitImages"   Source="$(var.StageDir)config\initImages.txt"        KeyPath="yes" /></Component>
      <Component Id="cmp.CfgFilter"       Guid="*" Directory="ConfigDir"><File Id="file.CfgFilter"       Source="$(var.StageDir)config\filter.txt"            KeyPath="yes" /></Component>
      <Component Id="cmp.CfgLogConf"      Guid="*" Directory="ConfigDir"><File Id="file.CfgLogConf"      Source="$(var.StageDir)config\log.conf"              KeyPath="yes" /></Component>
    </ComponentGroup>
  </Fragment>

  <!-- ===================== GUI + Start Menu shortcut ===================== -->
  <Fragment>
    <Component Id="cmp.GuiExe" Guid="*" Directory="GuiDir">
      <File Id="file.GuiExe" Source="$(var.StageDir)gui\KellectConsole.exe" KeyPath="yes" />
    </Component>
    <Component Id="cmp.StartMenuShortcut" Guid="*" Directory="StartMenuDir">
      <Shortcut Id="sc.StartMenu" Name="kellect Console" Target="[#file.GuiExe]"
                WorkingDirectory="INSTALLDIR" Description="kellect visualization GUI" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Kellect\Install" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="rf.StartMenuDir" Directory="StartMenuDir" On="uninstall" />
    </Component>
  </Fragment>

  <!-- ===================== Qt runtime (dynamic GUI) ===================== -->
  <!-- Qt DLLs + platform plugin + VC142 CRT + UCRT, app-local in gui\ beside
       the GUI exe. Win7 has no system UCRT/CRT copies - this is what makes the
       GUI run there. Only files in the import-table closure of the shipped
       binaries are included (9 unused redist DLLs were verified unneeded and
       dropped). The VC142/UCRT sets deliberately bundle MANY Files per
       component: the runtime installs and uninstalls atomically as one unit. -->
  <Fragment>
    <ComponentGroup Id="cg.QtRuntime" Directory="GuiDir">
      <Component Id="cmp.QtCore"    Guid="*"><File Id="file.QtCore"    Source="$(var.StageDir)gui\Qt5Core.dll"    KeyPath="yes" /></Component>
      <Component Id="cmp.QtGui"     Guid="*"><File Id="file.QtGui"     Source="$(var.StageDir)gui\Qt5Gui.dll"     KeyPath="yes" /></Component>
      <Component Id="cmp.QtWidgets" Guid="*"><File Id="file.QtWidgets" Source="$(var.StageDir)gui\Qt5Widgets.dll" KeyPath="yes" /></Component>
      <Component Id="cmp.QtNet"     Guid="*"><File Id="file.QtNet"     Source="$(var.StageDir)gui\Qt5Network.dll" KeyPath="yes" /></Component>
      <Component Id="cmp.QtPlatformPlugin" Guid="*" Directory="QtPlatformsDir">
        <File Id="file.QtQwindows" Source="$(var.StageDir)gui\platforms\qwindows.dll" KeyPath="yes" />
      </Component>
      <Component Id="cmp.VcRuntime" Guid="F831A849-DF04-49BB-953C-296A6D343F97">
        <File Id="file.Crt.msvcp140" Source="$(var.StageDir)gui\msvcp140.dll" />
        <File Id="file.Crt.msvcp140_1" Source="$(var.StageDir)gui\msvcp140_1.dll" />
        <File Id="file.Crt.vcruntime140" Source="$(var.StageDir)gui\vcruntime140.dll" KeyPath="yes" />
        <File Id="file.Crt.vcruntime140_1" Source="$(var.StageDir)gui\vcruntime140_1.dll" />
      </Component>
      <Component Id="cmp.UcrtRuntime" Guid="B48F101A-9434-4860-921A-961F684DBCB4">
        <File Id="file.Ucrt.api_ms_win_core_console_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-console-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_console_l1_2_0" Source="$(var.StageDir)gui\api-ms-win-core-console-l1-2-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_datetime_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-datetime-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_debug_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-debug-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_errorhandling_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-errorhandling-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_file_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-file-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_file_l1_2_0" Source="$(var.StageDir)gui\api-ms-win-core-file-l1-2-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_file_l2_1_0" Source="$(var.StageDir)gui\api-ms-win-core-file-l2-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_handle_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-handle-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_heap_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-heap-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_interlocked_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-interlocked-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_libraryloader_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-libraryloader-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_localization_l1_2_0" Source="$(var.StageDir)gui\api-ms-win-core-localization-l1-2-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_memory_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-memory-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_namedpipe_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-namedpipe-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_processenvironment_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-processenvironment-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_processthreads_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-processthreads-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_processthreads_l1_1_1" Source="$(var.StageDir)gui\api-ms-win-core-processthreads-l1-1-1.dll" />
        <File Id="file.Ucrt.api_ms_win_core_profile_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-profile-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_rtlsupport_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-rtlsupport-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_string_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-string-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_synch_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-synch-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_synch_l1_2_0" Source="$(var.StageDir)gui\api-ms-win-core-synch-l1-2-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_sysinfo_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-sysinfo-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_timezone_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-timezone-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_core_util_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-core-util-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_convert_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-convert-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_environment_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-environment-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_filesystem_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-filesystem-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_heap_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-heap-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_locale_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-locale-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_math_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-math-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_runtime_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-runtime-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_stdio_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-stdio-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_string_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-string-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_time_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-time-l1-1-0.dll" />
        <File Id="file.Ucrt.api_ms_win_crt_utility_l1_1_0" Source="$(var.StageDir)gui\api-ms-win-crt-utility-l1-1-0.dll" />
        <File Id="file.Ucrt.ucrtbase" Source="$(var.StageDir)gui\ucrtbase.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
