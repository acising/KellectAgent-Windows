docs/*
!docs/superpowers/


# KellectConsole (.NET)
obj/
*.user
gui/*/bin/
gui/*/obj/

# kellect 运行时日志(已跟踪的旧空 log 占位不受影响)
release/log/*.log

# WiX MSI build outputs (Step 3): staged binaries + built .msi + logs
installer/stage/
installer/build-msi/
installer/*.log

# CMake build dirs (collector x86/x64 + service wrapper)
build-*/

# Top-level + GUI build logs
/*.log
gui/*/build.log

# Portable bundle (binaries, not for git)
KellectConsole-win-x64/

# Test-build packages: MSI/zip copies + portable bundle (binaries, not for git)
dist/